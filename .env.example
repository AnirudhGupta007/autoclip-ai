# ─── Required API keys ───────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
PEXELS_API_KEY=your_pexels_api_key_here

# ─── Models (override only if you know what you're doing) ────
GEMINI_MODEL_MULTIMODAL=gemini-2.5-flash
GEMINI_MODEL_LITE=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# ─── Storage ─────────────────────────────────────────────────
DATABASE_URL=sqlite:///./autoclip.db
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

# ─── Optional: Postgres + pgvector for production ────────────
# DATABASE_URL=postgresql+psycopg2://autoclip:pw@localhost:5432/autoclip
# LANGGRAPH_PG_URL=postgresql://autoclip:pw@localhost:5432/autoclip   # for PostgresSaver checkpointer
# USE_PGVECTOR=1

# ─── Optional: Redis for live SSE pub/sub ────────────────────
# REDIS_URL=redis://localhost:6379/0

# ─── Pipeline tuning ─────────────────────────────────────────
CHUNK_LENGTH_SECONDS=120
CHUNK_OVERLAP_SECONDS=10
CHUNK_MAX=60
SCENE_THRESHOLD=0.3

# ─── LangSmith tracing (free observability) ──────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_PROJECT=Autoclip
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
