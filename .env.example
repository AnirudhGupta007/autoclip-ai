# ─── Required API keys ───────────────────────────────────────
# OpenRouter is the ONLY LLM provider in this app — orchestrator reasoning,
# subagents, clip scoring/titles, chat replies, frame-sampled vision
# analysis, and audio transcription all go through it. Get a key at
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
PEXELS_API_KEY=your_pexels_api_key_here

# ─── Models (all via OpenRouter — override only if you know what you're doing) ──
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Deep-agent orchestrator + subagents — needs solid tool-calling.
OPENROUTER_MODEL=google/gemini-2.5-flash
# Scoring / titles / chat replies — fast + cheap.
OPENROUTER_MODEL_LITE=qwen/qwen3-30b-a3b-instruct-2507
# Frame-sampled chunk analysis (OpenRouter has no native video upload).
OPENROUTER_MODEL_VISION=google/gemini-2.5-flash-lite
# Audio-part transcription (OpenRouter has no dedicated ASR endpoint).
# Any OpenRouter model with audio input works, e.g. google/gemini-3.5-flash-lite.
OPENROUTER_MODEL_AUDIO=google/gemini-2.5-flash-lite

# ─── Embeddings (via OpenRouter /embeddings, open-source BGE-M3) ───
EMBEDDING_MODEL_NAME=baai/bge-m3
EMBEDDING_DIM=1024

# Transcription: audio is split into short segments transcribed in parallel.
# Long segments overflow the output cap / make Gemini loop (values >240 fall back to 180).
TRANSCRIBE_SEGMENT_SECONDS=180
TRANSCRIBE_PARALLELISM=4
TRANSCRIBE_MAX_TOKENS=8192
# Attempts per segment before splitting it in half (loops/truncation/bad JSON retry).
TRANSCRIBE_ATTEMPTS=3
# Warn when < this fraction of non-silent 20s windows contain transcript.
TRANSCRIBE_MIN_COVERAGE=0.8
# Timestamp format requested from the model: mmss (MM:SS strings) | seconds
TRANSCRIBE_TIMESTAMP_FORMAT=mmss

# ─── Chunk vision analysis ───────────────────────────────────
# frames = N JPEGs spread evenly over each chunk (cheap, no audio)
# video  = each chunk sent as a native video_url part with its audio (~5x tokens)
VISION_INPUT_MODE=frames
VISION_MAX_FRAMES=24
VISION_FRAME_WIDTH=768
VISION_VIDEO_HEIGHT=360
VISION_MAX_TOKENS=4096
CHUNK_ANALYZE_ATTEMPTS=2
# Concurrent ffmpeg frame-sampling jobs across chunks (~100 MB RSS each; keep low on 2 GB boxes).
VISION_FFMPEG_CONCURRENCY=2

# ─── Global fusion dedupe ────────────────────────────────────
# Embedding near-duplicates are only merged within this many seconds.
FUSION_DEDUPE_THRESHOLD=0.92
FUSION_DEDUPE_WINDOW_SECONDS=180

# ─── Storage ─────────────────────────────────────────────────
DATABASE_URL=sqlite:///./autoclip.db
UPLOAD_DIR=./uploads
# Upload cap (MB); keep frontend nginx client_max_body_size >= this.
MAX_UPLOAD_SIZE_MB=500
OUTPUT_DIR=./outputs

# ─── Optional: Postgres + pgvector for production ────────────
# DATABASE_URL=postgresql+psycopg2://autoclip:pw@localhost:5432/autoclip
# LANGGRAPH_PG_URL=postgresql://autoclip:pw@localhost:5432/autoclip   # for PostgresSaver checkpointer
# USE_PGVECTOR=1

# ─── Optional: Redis for live SSE pub/sub ────────────────────
# REDIS_URL=redis://localhost:6379/0

# ─── Pipeline tuning ─────────────────────────────────────────
CHUNK_LENGTH_SECONDS=120
CHUNK_OVERLAP_SECONDS=10
# Max chunks per video (~110 min at 120s chunks). Longer videos get proportionally
# longer chunks (sparser frames) with a loud warning in the logs — never truncated.
CHUNK_MAX=60
SCENE_THRESHOLD=0.3

# ─── LangSmith tracing (free observability) ──────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_PROJECT=Autoclip
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ─── Accounts (backend/src/autoclip/auth/settings.py) ─────────
# Admins: no chat quota, no upload caps. Sign up with this email right after
# deploying (migration 0002 may have created it without a password).
ADMIN_EMAILS=you@example.com
# 1 behind HTTPS (prod overlay sets it): Secure `__Host-session` cookie.
COOKIE_SECURE=0
# CORS allow-list — never "*" (cookies are credentials). nginx serves the SPA
# same-origin, so this only matters for `npm run dev` on another port.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Upload caps for non-admin users.
MAX_VIDEOS_PER_USER=5
MAX_VIDEO_MINUTES_DEMO=60
# Shared read-only demo account ("Try demo"); seed it with
# backend/scripts/seed_demo.py --video-id <id>
DEMO_ENABLED=1
DEMO_EMAIL=demo@autoclip.local
DEMO_DAILY_QUERY_LIMIT=10
# Abuse limits
SIGNUP_LIMIT_PER_IP_PER_DAY=5
LOGIN_LIMIT_PER_15_MIN=10

# ─── Chat quota ──────────────────────────────────────────────
# Chat queries (agent runs) allowed per user per UTC day (admins: unlimited).
DAILY_QUERY_LIMIT=2
# Per-IP backstop across accounts; 0 = off.
IP_DAILY_QUERY_LIMIT=20
# Optional site-wide cap per day as a credit backstop; 0 = off.
DAILY_GLOBAL_QUERY_LIMIT=0
